# Copier vers /var/www/zen2property/.env puis adapter les secrets.
NODE_ENV=production
HOST=127.0.0.1
PORT=3100
APP_ORIGIN=https://zen2property.com

# Postgres du compose isolé (127.0.0.1:55433)
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DATABASE_URL=postgres://zen2property:CHANGE_ME_STRONG_PASSWORD@127.0.0.1:55433/zen2property

JWT_SECRET=CHANGE_ME_LONG_RANDOM_SECRET_32CHARS
JWT_EXPIRES_IN=7d

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

RECEIPTS_DIR=/var/www/zen2property/storage/receipts

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_TAX_ENABLED=false

BOOTSTRAP_ADMIN_EMAIL=
