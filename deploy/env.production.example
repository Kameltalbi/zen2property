# Copier vers /var/www/rentelyo/.env puis adapter les secrets.
NODE_ENV=production
HOST=127.0.0.1
PORT=3120
APP_ORIGIN=https://www.rentelyo.com

# Postgres du compose isolé (127.0.0.1:55433)
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DATABASE_URL=postgres://rentelyo:CHANGE_ME_STRONG_PASSWORD@127.0.0.1:55433/rentelyo

JWT_SECRET=CHANGE_ME_LONG_RANDOM_SECRET_32CHARS
JWT_EXPIRES_IN=7d

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

RECEIPTS_DIR=/var/www/rentelyo/storage/receipts

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_TAX_ENABLED=false

BOOTSTRAP_ADMIN_EMAIL=

# Envoi des liens de réinitialisation de mot de passe (obligatoire en production)
RESEND_API_KEY=re_CHANGE_ME
EMAIL_FROM=no-reply@rentelyo.com
