{
  "name": "rentelyo-saas",
  "version": "0.1.0",
  "private": true,
  "description": "Rentelyo SaaS — simple rental management (Express API + React web)",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:web": "npm run dev --prefix web",
    "dev:all": "concurrently -n api,web -c blue,green \"npm run dev\" \"npm run dev:web\"",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "build:web": "npm run build --prefix web",
    "migrate": "tsx src/db/migrate.ts",
    "test:pricing": "tsx src/modules/billing/pricingMarkets.test.ts && tsx src/modules/billing/stripeClient.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && npm run build --prefix web --if-present"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "pdfkit": "^0.16.0",
    "pg": "^8.13.1",
    "stripe": "^17.7.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.13.5",
    "@types/pdfkit": "^0.13.9",
    "@types/pg": "^8.11.11",
    "concurrently": "^10.0.5",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
